{
  "name": "portfolio",
  "private": true,
  "description": "Andrea Ciardi's portfolio: scroll through 18 years of frontend development.",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@portfolio/web",
    "storybook": "turbo run dev --filter=@portfolio/storybook",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "turbo": "^2.11.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
